# Server-side configuration used by the MVP spike (SPEC.md §7).
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Neon PostgreSQL connection string (pooled endpoint recommended for dev).
DATABASE_URL=postgres://user:password@host/dbname

# OpenAI-compatible model gateway. Supported: openrouter | groq
MODEL_PROVIDER=openrouter

# API key for the selected provider (OpenRouter or Groq). Server-side only.
LLM_API_KEY=

# Optional override of the OpenAI-compatible base URL. Sensible defaults are
# built in: openrouter -> https://openrouter.ai/api/v1
#           groq       -> https://api.groq.com/openai/v1
LLM_BASE_URL=

# Model path WITHOUT the provider prefix, for example:
#   openrouter: meta-llama/llama-3.3-70b-instruct
#   groq:       llama-3.3-70b-versatile
# The agent builds the Mastra model id as `${MODEL_PROVIDER}/${LLM_MODEL}`.
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Public base URL of the local app.
APP_BASE_URL=http://localhost:3000
